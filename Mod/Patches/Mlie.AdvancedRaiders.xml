<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Advanced Raiders (Continued) reecrit ce fichier en entier.

     Source : Advanced Raiders (Continued) (Mlie.AdvancedRaiders)
     Corrections : 1 -->
<Patch>

  <!-- Apparel_BlueScreenBelt : Medieval -> Industrial -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Apparel_BlueScreenBelt"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Apparel_BlueScreenBelt"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Apparel_BlueScreenBelt"]/techLevel</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Apparel_BlueScreenBelt"]</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </nomatch>
    </match>
  </Operation>

</Patch>
