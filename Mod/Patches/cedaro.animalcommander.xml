<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Animal Commander reecrit ce fichier en entier.

     Source : Animal Commander (cedaro.animalcommander)
     Corrections : 1 -->
<Patch>

  <!-- ASC_ManualLeader : Archotech -> Neolithic -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="ASC_ManualLeader"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ASC_ManualLeader"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="ASC_ManualLeader"]/techLevel</xpath>
        <value><techLevel>Neolithic</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ASC_ManualLeader"]</xpath>
        <value><techLevel>Neolithic</techLevel></value>
      </nomatch>
    </match>
  </Operation>

</Patch>
