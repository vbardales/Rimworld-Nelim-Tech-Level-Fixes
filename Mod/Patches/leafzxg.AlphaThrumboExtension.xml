<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Alpha Thrumbo Extension reecrit ce fichier en entier.

     Source : Alpha Thrumbo Extension (leafzxg.AlphaThrumboExtension)
     Corrections : 1 -->
<Patch>

  <!-- AlphaThrumboMilk : Medieval -> Spacer -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AlphaThrumboMilk"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AlphaThrumboMilk"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="AlphaThrumboMilk"]/techLevel</xpath>
        <value><techLevel>Spacer</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="AlphaThrumboMilk"]</xpath>
        <value><techLevel>Spacer</techLevel></value>
      </nomatch>
    </match>
  </Operation>

</Patch>
