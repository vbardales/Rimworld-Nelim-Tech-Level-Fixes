<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Armor Racks reecrit ce fichier en entier.

     Source : Armor Racks (khamenman.armorracks)
     Corrections : 3

     Modifie a la main le 2026-09-24 : cherrypick avait ecrit chaque objet deux fois (6 operations),
     parce que le mod embarque un dossier v1.1 qui duplique ses defs. Une seule operation est gardee
     par objet ; les niveaux sont ceux proposes par l'outil. Tests/Check-Patches.ps1 refuse
     les doublons, donc une nouvelle passe de cherrypick devra dedoublonner de la meme facon.
     Correction durable a faire dans la generation de cherrypick, pas ici. -->
<Patch>

  <!-- ArmorRacks_ArmorRack : (aucun) -> Medieval -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="ArmorRacks_ArmorRack"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ArmorRacks_ArmorRack"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="ArmorRacks_ArmorRack"]/techLevel</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ArmorRacks_ArmorRack"]</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </nomatch>
    </match>
  </Operation>


  <!-- ArmorRacks_MechanizedArmorRack : (aucun) -> Industrial -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="ArmorRacks_MechanizedArmorRack"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ArmorRacks_MechanizedArmorRack"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="ArmorRacks_MechanizedArmorRack"]/techLevel</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ArmorRacks_MechanizedArmorRack"]</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </nomatch>
    </match>
  </Operation>


  <!-- ArmorRacks_MendingArmorRack : (aucun) -> Spacer -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="ArmorRacks_MendingArmorRack"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ArmorRacks_MendingArmorRack"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="ArmorRacks_MendingArmorRack"]/techLevel</xpath>
        <value><techLevel>Spacer</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ArmorRacks_MendingArmorRack"]</xpath>
        <value><techLevel>Spacer</techLevel></value>
      </nomatch>
    </match>
  </Operation>


</Patch>
