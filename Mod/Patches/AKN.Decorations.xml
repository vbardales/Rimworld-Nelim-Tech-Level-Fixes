<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Akeron - Decorations reecrit ce fichier en entier.

     Source : Akeron - Decorations (AKN.Decorations)
     Corrections : 5 -->
<Patch>

  <!-- AKN_DecorativeCables : (aucun) -> Industrial -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AKN_DecorativeCables"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AKN_DecorativeCables"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="AKN_DecorativeCables"]/techLevel</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="AKN_DecorativeCables"]</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </nomatch>
    </match>
  </Operation>

