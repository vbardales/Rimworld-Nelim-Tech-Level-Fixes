<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Animal Repeller reecrit ce fichier en entier.

     Source : Animal Repeller (rye.animalrepeller)
     Corrections : 1 -->
<Patch>

  <!-- AnimalRepeller : (aucun) -> Industrial -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AnimalRepeller"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AnimalRepeller"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="AnimalRepeller"]/techLevel</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="AnimalRepeller"]</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </nomatch>
    </match>
  </Operation>

</Patch>
