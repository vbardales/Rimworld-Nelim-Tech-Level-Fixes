<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Crystal Bodyparts (Continued) reecrit ce fichier en entier.

     Source : Crystal Bodyparts (Continued) (zal.crystalbodyparts)
     Corrections : 7 -->
<Patch>

  <!-- AdvCrystalArm : Medieval -> Archotech -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AdvCrystalArm"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AdvCrystalArm"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="AdvCrystalArm"]/techLevel</xpath>
        <value><techLevel>Archotech</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="AdvCrystalArm"]</xpath>
        <value><techLevel>Archotech</techLevel></value>
      </nomatch>
    </match>
  </Operation>

