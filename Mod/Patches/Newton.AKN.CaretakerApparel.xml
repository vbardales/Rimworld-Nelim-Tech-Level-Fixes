<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Akeron - Caretaker Apparel reecrit ce fichier en entier.

     Source : Akeron - Caretaker Apparel (Newton.AKN.CaretakerApparel)
     Corrections : 1 -->
<Patch>

  <!-- AKN_CaretakerPlateHelmet : Industrial -> Medieval -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AKN_CaretakerPlateHelmet"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AKN_CaretakerPlateHelmet"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="AKN_CaretakerPlateHelmet"]/techLevel</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="AKN_CaretakerPlateHelmet"]</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </nomatch>
    </match>
  </Operation>

</Patch>
