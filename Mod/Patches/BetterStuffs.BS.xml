<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     BetterStuffs reecrit ce fichier en entier.

     Source : BetterStuffs (BetterStuffs.BS)
     Corrections : 4 -->
<Patch>

  <!-- LOW_Apparel_BetterCowboyHat : Medieval -> Industrial -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="LOW_Apparel_BetterCowboyHat"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="LOW_Apparel_BetterCowboyHat"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="LOW_Apparel_BetterCowboyHat"]/techLevel</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="LOW_Apparel_BetterCowboyHat"]</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </nomatch>
    </match>
  </Operation>

