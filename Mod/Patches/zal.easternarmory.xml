<Patch>

  <!-- Ancient_AshigaruArmor : (aucun) -> Medieval -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Ancient_AshigaruArmor"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Ancient_AshigaruArmor"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Ancient_AshigaruArmor"]/techLevel</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Ancient_AshigaruArmor"]</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </nomatch>
    </match>
  </Operation>

