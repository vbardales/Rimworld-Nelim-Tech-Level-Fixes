<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Archotech Duality reecrit ce fichier en entier.

     Source : Archotech Duality (dot.atlas)
     Corrections : 3 -->
<Patch>

  <!-- Atlas_Aerogel : (aucun) -> Industrial -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Atlas_Aerogel"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Atlas_Aerogel"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Atlas_Aerogel"]/techLevel</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Atlas_Aerogel"]</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </nomatch>
    </match>
  </Operation>

