    </match>
  </Operation>

  <!-- CursedSerum : Industrial -> Spacer -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="CursedSerum"]</xpath>
    <success>Always</success>
