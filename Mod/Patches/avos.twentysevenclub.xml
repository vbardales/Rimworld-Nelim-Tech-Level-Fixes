        <xpath>/Defs/ThingDef[defName="CursedSerum"]/techLevel</xpath>
        <value><techLevel>Spacer</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="CursedSerum"]</xpath>
        <value><techLevel>Spacer</techLevel></value>
      </nomatch>
    </match>
  </Operation>

</Patch>
