<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Animal Simple Command reecrit ce fichier en entier.

     Source : Animal Simple Command (Udon.AnimalSimpleCommand)
     Corrections : 4 -->
<Patch>

  <!-- ASC_ManualDefend : Archotech -> Neolithic -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="ASC_ManualDefend"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ASC_ManualDefend"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="ASC_ManualDefend"]/techLevel</xpath>
        <value><techLevel>Neolithic</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ASC_ManualDefend"]</xpath>
        <value><techLevel>Neolithic</techLevel></value>
      </nomatch>
    </match>
  </Operation>

