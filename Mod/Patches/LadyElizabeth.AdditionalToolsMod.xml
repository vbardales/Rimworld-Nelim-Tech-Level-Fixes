<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Additional Tools Mod reecrit ce fichier en entier.

     Source : Additional Tools Mod (LadyElizabeth.AdditionalToolsMod)
     Corrections : 6 -->
<Patch>

  <!-- Book_Generic : Industrial -> Medieval -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Book_Generic"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Book_Generic"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Book_Generic"]/techLevel</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Book_Generic"]</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </nomatch>
    </match>
  </Operation>

