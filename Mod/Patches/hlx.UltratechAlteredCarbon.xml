<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Altered Carbon 2: ReSleeved reecrit ce fichier en entier.

     Source : Altered Carbon 2: ReSleeved (hlx.UltratechAlteredCarbon)
     Corrections : 11 -->
<Patch>

  <!-- AC_CastingRelay : (aucun) -> Ultra -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AC_CastingRelay"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AC_CastingRelay"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="AC_CastingRelay"]/techLevel</xpath>
        <value><techLevel>Ultra</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="AC_CastingRelay"]</xpath>
        <value><techLevel>Ultra</techLevel></value>
      </nomatch>
    </match>
  </Operation>

