<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Ancient Junk Loot reecrit ce fichier en entier.

     Source : Ancient Junk Loot (Romyashi.AncientJunkLoot)
     Corrections : 6

     Modifie a la main le 2026-09-21 : les six vont en Animal (decision de l'utilisateur, ce sont
     des vestiges laisses par les Anciens, on peut en trouver des l'ere animale). Etaient : cinq en
     Industrial, un en Spacer. Une nouvelle passe de cherrypick reecrirait ce fichier avec ce
     qu'il a en memoire : y refaire l'arbitrage avant de regenerer. -->
<Patch>

  <!-- Romy_AncientMicrowave : (aucun) -> Animal -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Romy_AncientMicrowave"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Romy_AncientMicrowave"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Romy_AncientMicrowave"]/techLevel</xpath>
        <value><techLevel>Animal</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Romy_AncientMicrowave"]</xpath>
        <value><techLevel>Animal</techLevel></value>
      </nomatch>
    </match>
  </Operation>

