<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Ancient Relics reecrit ce fichier en entier.

     Source : Ancient Relics (Romyashi.AncientRelics)
     Corrections : 5 -->
<Patch>

  <!-- Romy_Artillery_AncientMortar : (aucun) -> Ultra -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Romy_Artillery_AncientMortar"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Romy_Artillery_AncientMortar"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Romy_Artillery_AncientMortar"]/techLevel</xpath>
        <value><techLevel>Ultra</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Romy_Artillery_AncientMortar"]</xpath>
        <value><techLevel>Ultra</techLevel></value>
      </nomatch>
    </match>
  </Operation>

