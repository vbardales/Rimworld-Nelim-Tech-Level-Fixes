<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Alternative Power Solutions (Continued) reecrit ce fichier en entier.

     Source : Alternative Power Solutions (Continued) (zal.alternativepowersolutions)
     Corrections : 3 -->
<Patch>

  <!-- APS_ConcentratedSolarPowerStation : (aucun) -> Industrial -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="APS_ConcentratedSolarPowerStation"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="APS_ConcentratedSolarPowerStation"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="APS_ConcentratedSolarPowerStation"]/techLevel</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="APS_ConcentratedSolarPowerStation"]</xpath>
        <value><techLevel>Industrial</techLevel></value>
      </nomatch>
    </match>
  </Operation>

