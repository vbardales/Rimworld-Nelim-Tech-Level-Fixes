<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Alpha Books reecrit ce fichier en entier.

     Source : Alpha Books (sarg.alphabooks)
     Corrections : 23 -->
<Patch>

  <!-- ABooks_AdventuringLogs : (aucun) -> Medieval -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="ABooks_AdventuringLogs"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ABooks_AdventuringLogs"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="ABooks_AdventuringLogs"]/techLevel</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ABooks_AdventuringLogs"]</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </nomatch>
    </match>
  </Operation>

