<?xml version="1.0" encoding="utf-8"?>
<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Aquarium (Continued) reecrit ce fichier en entier.

     Source : Aquarium (Continued) (Mlie.Aquarium)
     Corrections : 10

     Modifie a la main le 2026-09-24 : deux recherches du mod (AQFishPets, AQGelatin) passent en
     Neolithic, decision de l'utilisateur (le realisme d'abord, meme si leur prerequis Smithing est
     Medieval). Cherrypick ne sait pas ecrire une recherche : une nouvelle passe les perdrait, il
     faut alors les remettre. AQGelatin designe ici deux defs distinctes, l'objet et la recherche. -->
<Patch>

  <!-- AQCollagen : (aucun) -> Neolithic -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AQCollagen"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="AQCollagen"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="AQCollagen"]/techLevel</xpath>
        <value><techLevel>Neolithic</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="AQCollagen"]</xpath>
        <value><techLevel>Neolithic</techLevel></value>
      </nomatch>
    </match>
  </Operation>

