<!-- Genere par cherrypick. Ne pas modifier a la main : une nouvelle passe sur
     Angel Arm Revolver (Continued) reecrit ce fichier en entier.

     Source : Angel Arm Revolver (Continued) (zal.angelarm)
     Corrections : 1 -->
<Patch>

  <!-- VashGlasses : (aucun) -> Medieval -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="VashGlasses"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="VashGlasses"]/techLevel</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="VashGlasses"]/techLevel</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VashGlasses"]</xpath>
        <value><techLevel>Medieval</techLevel></value>
      </nomatch>
    </match>
  </Operation>

</Patch>
