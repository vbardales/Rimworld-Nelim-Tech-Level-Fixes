<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TechLevelFixes.Tests</AssemblyName>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RimWorldManaged" Value="$(RimWorldManaged)" />
    <AssemblyMetadata Include="ModRoot" Value="$(MSBuildThisFileDirectory)..\Mod" />
    <!-- The mod itself ships no assembly, so there is nothing of its own to reference: these tests
         run RimWorld's own patch operations over the shipped XML. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Only to switch off RimWorld's deep profiler, which PatchOperation.Apply calls and which
         needs the game's Unity infrastructure to exist. Nothing here is Harmony-patched in anger. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
