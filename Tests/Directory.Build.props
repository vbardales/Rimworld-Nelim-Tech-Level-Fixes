<Project>
  <PropertyGroup>
    <!-- Intermediates leave the repository: Mod/ is handed to Steam as it stands, and .build/ is
         git-ignored. NuGet reads this before the csproj, which is why it lives here. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\tests\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\tests\bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
