# Build intermediates.
# Directory.Build.props sends them outside the mod folder: they must never end up in it,
# since the whole folder goes to the Workshop as it stands.
.build/
Source/obj/
Source/bin/

# Development environments
.vs/
.vscode/
.idea/
*.user
*.suo
*.csproj.user

# Claude Code session worktrees and local settings. A session creates its worktree in the
# current directory, so sometimes inside this one, and each is a full copy of the repository.
.claude/

# Showcase notes: working notes for image generation, deleted once Preview.png and
# ModIcon.png are done.
PROMPT_*.md

# Test evidence kept on disk, never in git (AGENTS.md, "Test evidence"). Captures and Player.log make
# it grow without limit; the history is one line per run in docs/runs/history.md.
Tests/Pickle/Evidence/
evidence/

# Compiled textures. This mod ships none; listed so one can never be committed by accident.
*.dds
